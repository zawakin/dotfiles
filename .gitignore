# Fish auto-generated files
fish/.config/fish/fish_variables
fish/.config/fish/conf.d/

# Agent skills are symlinked from ghq-managed repos via `make claude-skills`.
# The symlinks are machine-specific (ghq paths), so generate them per machine
# instead of committing. Keep the directory itself via .gitkeep.
claude/.claude/skills/*
!claude/.claude/skills/.gitkeep
agents/.agents/skills/*
!agents/.agents/skills/.gitkeep

# brew bundle on Homebrew >= 4.5 no longer writes a lock file; ignore one if an
# older brew ever produces it. The Brewfile itself is the only tracked source.
Brewfile.lock.json
.Brewfile.lock.json

# tmux workspaces (tw save) reference local repo paths, many of them private
# or not on GitHub at all, so they are machine-specific. dotfiles.conf is kept
# as the example.
tmux/.config/tmux/workspaces/*.conf
!tmux/.config/tmux/workspaces/dotfiles.conf
